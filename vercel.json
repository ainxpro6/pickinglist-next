{
  "functions": {
    "api/*.py": {
      "runtime": "@vercel/python@latest"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Expose-Headers",
          "value": "Content-Disposition"
        }
      ]
    }
  ]
}
